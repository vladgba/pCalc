<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_angle"
            style="@style/P.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:minWidth="56dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="RAD" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_graph"
            style="@style/P.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_graph" />

        <Button
            android:id="@+id/btn_formulas"
            style="@style/P.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_formulas" />
    </LinearLayout>

    <x.vladgba.calc.PullDownLayout
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_previous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:textColor="@color/text_dim"
            android:textSize="20sp" />

        <x.vladgba.calc.ExprField
            android:id="@+id/tv_expr"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:padding="0dp"
            android:gravity="end|bottom"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text"
            android:hint="0"
            android:textColorHint="@color/text_faint"
            android:textCursorDrawable="@null"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:textSize="60sp" />

        <TextView
            android:id="@+id/tv_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_dim"
            android:textSize="28sp" />
    </x.vladgba.calc.PullDownLayout>

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp" />

    <x.vladgba.calc.PagerView
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.45" />
</LinearLayout>

<LinearLayout
    android:id="@+id/history_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:elevation="8dp"
    android:visibility="invisible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <TextView
            style="@style/P.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/history" />

        <Button
            android:id="@+id/btn_clear_history"
            style="@style/P.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear" />
    </LinearLayout>

    <TextView
        style="@style/P.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text="@string/history_help" />

    <ScrollView
        android:id="@+id/history_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />
    </ScrollView>

    <!-- Drag handle: drag up or tap to close -->
    <FrameLayout
        android:id="@+id/history_grip"
        android:layout_width="match_parent"
        android:layout_height="40dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="@drawable/grip" />
    </FrameLayout>
</LinearLayout>
</FrameLayout>
